// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" // Was "prisma-client" before, but this setup require an output path
  // output   = "../lib/generated/prisma" // We comment this out to avoid it to generate the client in a weird place
}

datasource db {
  provider = "postgresql"
}

model Item {
  id Int @id @default(autoincrement())
  label String @db.VarChar(255)
}